# ---- Database ----
# For docker-compose the host is `postgres`; for local dev point this at localhost.
DATABASE_URL=postgresql+psycopg2://rag:rag@postgres:5432/rag

# ---- Vector store ----
CHROMA_PERSIST_DIR=/app/data/chroma

# ---- LLM provider selection ----
# One of: openai | anthropic
LLM_PROVIDER=anthropic

# Supply whichever key matches LLM_PROVIDER. The other can stay blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model names for each provider (override only if you know why).
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Embeddings ----
# Keep consistent across ingest + query — mismatched dims silently corrupt retrieval.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Chunking ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---- Ops ----
LOG_LEVEL=INFO
UPLOAD_DIR=/app/data/uploads
